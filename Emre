<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <title>Senin İçin 💖</title>
  <style>
    body {
      background: pink;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
      flex-direction: column;
      font-family: "Comic Sans MS", cursive, sans-serif;
      text-align: center;
      color: #d6006f;
    }
    .message {
      font-size: 2em;
      margin: 20px;
      font-weight: bold;
    }
    .heart {
      position: absolute;
      color: red;
      font-size: 24px;
      animation: float 5s infinite;
    }
    @keyframes float {
      0% { transform: translateY(0); opacity: 1; }
      100% { transform: translateY(-800px); opacity: 0; }
    }
  </style>
</head>
<body onclick="newMessage()">

  <div class="message">💖 Sevgilim, sen benim kalbimsin 💖</div>

  <script>
    const messages = [
      "💘 Sen benim en değerli hazinemsin 💘",
      "💖 Gülüşün dünyamı aydınlatıyor 💖",
      "💕 Sen yanımda olmasan bile kalbim hep seninle 💕",
      "🌹 Gözlerin en güzel yıldızlardan bile parlak 🌹",
      "💝 Seninle her gün özel 💝",
      "😍 Sen benim en güzel tesadüfümsün 😍",
      "💞 Kalbim sadece senin için atıyor 💞",
      "✨ Sen hayatımın mucizesisin ✨"
    ];
    const messageDiv = document.querySelector(".message");

    function newMessage() {
      const randomIndex = Math.floor(Math.random() * messages.length);
      messageDiv.textContent = messages[randomIndex];
      createHeart();
    }

    function createHeart() {
      const heart = document.createElement("div");
      heart.classList.add("heart");
      heart.textContent = "❤️";
      heart.style.left = Math.random() * 100 + "vw";
      heart.style.top = "100vh";
      heart.style.fontSize = Math.random() * 20 + 20 + "px";
      document.body.appendChild(heart);

      setTimeout(() => {
        heart.remove();
      }, 5000);
    }
  </script>
</body>
</html>
